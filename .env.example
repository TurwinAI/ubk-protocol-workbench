# Local API server port
PORT=8787

# Vite dev server port (used with `npm run dev`)
UI_PORT=5175

# Execution mode:
# - replay: Deterministic offline fixtures + real Z3 WASM SMT & axiom verification (default, no API key required)
# - live:   Calls Google Gemini API using GEMINI_API_KEY (fails loudly if key is missing or invalid)
PROTOTYPE_MODE=replay

# Required only when PROTOTYPE_MODE=live (or when running live mode from the UI)
GEMINI_API_KEY=

# Optional model override for live mode
GEMINI_MODEL=gemini-2.5-flash
